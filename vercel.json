{
    "version": 2,
    "installCommand": "cd client && npm install && cd ../server && npm install",
    "buildCommand": "cd client && npm run build",
    "outputDirectory": "client/dist",
    "framework": null,
    "rewrites": [
        {
            "src": "api/index.js",
            "use": "@vercel/node"
        },
        {
            "src": "/(.*)",
            "destination": "/client/dist/$1"
        }
    ]
}