{
    "version": 2,
    "installCommand": "cd client && npm install && cd ../server && npm install",
    "buildCommand": "cd client && npm run build",
    "outputDirectory": "client/dist",
    "functions": {
        "server.js": {
            "memory": 1024,
            "maxDuration": 10
        }
    },
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/server.js"
        },
        {
            "source": "/(.*)",
            "destination": "/client/dist/$1"
        }
    ]
}